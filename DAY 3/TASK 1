<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>

<title> WELCOME TO GTR MEOLODY </title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, sans-serif;
}

body{
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    
  
    background:
    linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.6)),
    url('https://images.unsplash.com/photo-1611859266238-4b98091d9d9b?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8bmlzc2FuJTIwZ3RyfGVufDB8fDB8fHww');

    background-size:cover;
    background-position:center;
    background-repeat:no-repeat;
}

.form-container{
    width:90%;
    max-width:850px;
    background:rgba(255,255,255,0.12);
    backdrop-filter:blur(12px);
    border:1px solid rgba(255,255,255,0.2);
    padding:40px;
    border-radius:20px;
    color:white;
    box-shadow:0 10px 30px rgba(0,0,0,0.4);
}

.form-container h1{
    text-align:center;
    margin-bottom:10px;
    font-size:40px;
}

.form-container p{
    text-align:center;
    margin-bottom:35px;
    color:#ddd;
}

.form-group{
    margin-bottom:20px;
}

label{
    display:block;
    margin-bottom:8px;
    font-size:15px;
}

input,
select,
textarea{
    width:100%;
    padding:14px;
    border:none;
    border-radius:10px;
    outline:none;
    background:rgba(255,255,255,0.15);
    color:white;
    font-size:15px;
}

input::placeholder,
textarea::placeholder{
    color:#ddd;
}

.row{
    display:flex;
    gap:20px;
}

.row .form-group{
    flex:1;
}

textarea{
    resize:none;
    height:100px;
}

button{
    width:100%;
    padding:15px;
    border:none;
    border-radius:12px;
    background:white;
    color:black;
    font-size:17px;
    font-weight:bold;
    cursor:pointer;
    transition:0.3s;
}

button:hover{
    background:#dcdcdc;
}

.social-icons{
    margin-top:25px;
    display:flex;
    justify-content:center;
    gap:18px;
}

.social-icons a{
    text-decoration:none;
    color:white;
    font-size:26px;
    transition:0.3s;
}

.social-icons a:hover{
    transform:scale(1.2);
    color:#ffcc00;
}

@media(max-width:700px){

    .row{
        flex-direction:column;
    }

    .form-container{
        padding:25px;
    }

    .form-container h1{
        font-size:30px;
    }

}

</style>
<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

</head>

<body>

<div class="form-container">

    <h1>WELCOME TO GTR MELODY</h1>
    <p>Fill the form properly</p>

    <form>

        <div class="row">

            <div class="form-group">
                <label>First Name</label>
                <input type="text" placeholder="Enter first name">
            </div>

            <div class="form-group">
                <label>Last Name</label>
                <input type="text" placeholder="Enter last name">
            </div>

        </div>

        <div class="row">

            <div class="form-group">
                <label>Email</label>
                <input type="email" placeholder="Enter email">
            </div>

            <div class="form-group">
                <label>Phone Number</label>
                <input type="tel" placeholder="Enter phone number">
            </div>

        </div>

        <div class="form-group">
    <label>Password</label>
    <input type="password" placeholder="Enter password">
</div>

        <div class="form-group">
            <label>Address</label>
            <textarea placeholder="Enter your address"></textarea>
        </div>

        <button type="submit">REGISTER NOW</button>

    </form>
    <div class="social-icons">

        <a href="#"><i class="fab fa-instagram"></i></a>

        <a href="#"><i class="fab fa-facebook"></i></a>

        <a href="#"><i class="fab fa-x-twitter"></i></a>

        <a href="#"><i class="fab fa-youtube"></i></a>

    </div>

</div>

</body>
</html>
