                                <td class="fw-bold text-white">Skyline R33 (1995)</td>
                                <td>2.6L RB26DETT I6</td>
                                <td class="text-warning fw-semibold">276 HP</td>
                                <td>5.2s</td>
                                <td>155 mph</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </section>

    <!-- Bootstrap Modal for Spec Details -->
    <div class="modal fade modal-gtr" id="specDetailModal" tabindex="-1" aria-labelledby="modalTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-secondary border-opacity-25">
                    <h5 class="modal-title font-sync text-uppercase text-white" id="modalTitle">GT-R Model Specs</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-borderless table-dark m-0" style="font-size: 14px;">
                            <tbody>
                                <tr>
                                    <td class="text-secondary ps-0 w-40">Engine Layout</td>
                                    <td class="text-white fw-bold" id="modalEngine">-</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary ps-0">Power Output</td>
                                    <td class="text-danger fw-bold" id="modalPower">-</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary ps-0">Drivetrain System</td>
                                    <td class="text-white" id="modalDrivetrain">-</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary ps-0">Transmission</td>
                                    <td class="text-white" id="modalTransmission">-</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary ps-0">Acceleration</td>
                                    <td class="text-white fw-semibold" id="modalAccel">-</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary ps-0">Top Speed</td>
                                    <td class="text-white" id="modalTopSpeed">-</td>
                                </tr>
                                <tr>
                                    <td class="text-secondary ps-0">Curb Weight</td>
                                    <td class="text-secondary" id="modalWeight">-</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer border-secondary border-opacity-25">
                    <button type="button" class="btn-gtr-primary btn-sm py-2 px-3" data-bs-dismiss="modal">Close Specs</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
    
        const header = document.getElementById('main-header');
        window.addEventListener('scroll', () => {
            if (window.scrollY > 50) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        });
        const searchInput = document.getElementById('gtrSearch');
        searchInput.addEventListener('input', function() {
            const query = this.value.toLowerCase();
            const rows = document.querySelectorAll('#gtrSpecTable tbody tr');
            
            rows.forEach(row => {
                const model = row.cells[1].textContent.toLowerCase();
                const engine = row.cells[2].textContent.toLowerCase();
                
                if (model.includes(query) || engine.includes(query)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

    
        function filterGeneration(gen) {
            // Update Active Filter State
            const filterBtns = document.querySelectorAll('.filter-btn');
            filterBtns.forEach(btn => btn.classList.remove('active'));
            event.target.classList.add('active');

            const rows = document.querySelectorAll('#gtrSpecTable tbody tr');
            rows.forEach(row => {
                const rowGen = row.getAttribute('data-gen');
                if (gen === 'all' || rowGen === gen) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
        function showSpecDetails(model, engine, power, accel, speed, transmission, weight, drivetrain) {
            document.getElementById('modalTitle').textContent = model + " Detailed Specifications";
            document.getElementById('modalEngine').textContent = engine;
            document.getElementById('modalPower').textContent = power;
            document.getElementById('modalAccel').textContent = accel;
            document.getElementById('modalTopSpeed').textContent = speed;
            document.getElementById('modalTransmission').textContent = transmission;
            document.getElementById('modalWeight').textContent = weight;
            document.getElementById('modalDrivetrain').textContent = drivetrain;

            const modal = new bootstrap.Modal(document.getElementById('specDetailModal'));
            modal.show();
        }
    </script>
</body>

</html>
