    <title>GT-R Performance Hub</title>

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome 6 Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Syncopate:wght@400;700&family=Outfit:wght@200;400;600;800&display=swap');

        :root {
            --nissan-red: #E22128;
            --nissan-red-hover: #b8151b;
            --deep-black: #080808;
            --dark-gray: #121212;
            --ui-border: rgba(255, 255, 255, 0.1);
            --neon-glow: rgba(226, 33, 40, 0.3);
        }

        body {
            background-color: var(--deep-black);
            color: #ffffff;
            font-family: 'Outfit', sans-serif;
            overflow-x: hidden;
        }

        /* Premium Brand Font for Headers */
        .font-sync {
            font-family: 'Syncopate', sans-serif;
            font-weight: 700;
        }

        /* Glassmorphic Sticky Header */
        .glass-header {
            background: rgba(8, 8, 8, 0.85);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid var(--ui-border);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .glass-header.scrolled {
            padding: 0.4rem 0 !important;
            background: rgba(0, 0, 0, 0.95);
            border-bottom: 2px solid var(--nissan-red);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8);
        }

        /* Customizable Navbar Links with active red indicator */
        .nav-link-gtr {
            position: relative;
            color: #999;
            transition: color 0.3s ease;
            letter-spacing: 0.25em;
            font-size: 13px;
            font-weight: 700;
            text-transform: uppercase;
            text-decoration: none;
            padding: 0.5rem 1rem;
            display: inline-block;
        }

        .nav-link-gtr:hover, .nav-link-gtr.active {
            color: #ffffff !important;
        }

        .nav-link-gtr::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 10%;
            width: 0;
            height: 2px;
            background-color: var(--nissan-red);
            transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .nav-link-gtr:hover::after, .nav-link-gtr.active::after {
            width: 80%;
        }

        /* Premium Custom Buttons */
        .btn-gtr-primary {
            background: var(--nissan-red);
            color: white;
            padding: 10px 24px;
            font-weight: 800;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            font-size: 11px;
            border: 1px solid var(--nissan-red);
            border-radius: 4px;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .btn-gtr-primary:hover {
            background: transparent;
            color: var(--nissan-red) !important;
            box-shadow: 0 0 15px var(--neon-glow);
            border-color: var(--nissan-red);
        }

        .btn-gtr-outline {
            background: transparent;
            color: #ffffff;
            padding: 10px 24px;
            font-weight: 800;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            font-size: 11px;
            border: 1px solid var(--ui-border);
            border-radius: 4px;
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .btn-gtr-outline:hover {
            background: rgba(255, 255, 255, 0.1);
            color: #ffffff;
            border-color: #ffffff;
        }

        /* Impeccable Custom Heights and Text Overlays */
        .carousel-item {
            height: 85vh;
            min-height: 500px;
            background-color: #000;
        }

        .carousel-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.75;
            transition: transform 6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .carousel-item.active img {
            transform: scale(1.05);
        }

        .carousel-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(8, 8, 8, 1) 5%, rgba(8, 8, 8, 0.3) 50%, rgba(8, 8, 8, 0.7) 100%);
            z-index: 1;
        }

        .carousel-caption-custom {
            position: absolute;
            bottom: 12%;
            left: 8%;
            z-index: 2;
            text-align: left;
        }

        .carousel-caption-custom h1 {
            font-size: 4.5rem;
            font-weight: 900;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            text-shadow: 0 4px 10px rgba(0, 0, 0, 0.9);
            margin-bottom: 5px;
        }

        .carousel-caption-custom p {
            font-size: 1.1rem;
            letter-spacing: 0.3em;
            color: #e0e0e0;
            text-transform: uppercase;
            font-weight: 600;
            border-left: 3px solid var(--nissan-red);
            padding-left: 15px;
        }

        /* Indicator Styling */
        .carousel-indicators [data-bs-target] {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background-color: #555;
            margin: 0 6px;
        }

        .carousel-indicators .active {
            background-color: var(--nissan-red);
            box-shadow: 0 0 10px var(--nissan-red);
        }

        /* Spec Table Styling */
        .spec-section {
            background-color: var(--deep-black);
            padding: 5rem 0;
            position: relative;
        }

        .spec-table-container {
            background-color: var(--dark-gray);
            border-radius: 12px;
            border: 1px solid var(--ui-border);
            padding: 1.5rem;
            box-shadow: 0 20px 50px rgba(0,0,0,0.8);
            transition: all 0.3s ease;
        }

        .spec-table-container:hover {
            border-color: rgba(226, 33, 40, 0.35);
            box-shadow: 0 25px 60px rgba(226, 33, 40, 0.1);
        }

        .table-gtr {
            color: #e0e0e0;
            margin-bottom: 0;
        }

        .table-gtr th {
            font-family: 'Syncopate', sans-serif;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            color: #888888;
            border-bottom: 2px solid var(--ui-border);
            padding: 15px 20px;
        }

        .table-gtr td {
            padding: 18px 20px;
            border-bottom: 1px solid var(--ui-border);
            vertical-align: middle;
            font-size: 15px;
            transition: background-color 0.2s ease;
        }

        .table-gtr tbody tr {
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .table-gtr tbody tr:hover td {
            background-color: rgba(255, 255, 255, 0.03);
            color: #ffffff;
        }

        .badge-generation {
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.1em;
            padding: 6px 12px;
            border-radius: 4px;
            text-transform: uppercase;
        }

        .badge-r35 {
            background-color: rgba(226, 33, 40, 0.15);
            color: var(--nissan-red);
            border: 1px solid rgba(226, 33, 40, 0.3);
        }

        .badge-r34 {
            background-color: rgba(0, 150, 255, 0.15);
            color: #0096ff;
            border: 1px solid rgba(0, 150, 255, 0.3);
        }

        .badge-r33 {
            background-color: rgba(255, 170, 0, 0.15);
            color: #ffaa00;
            border: 1px solid rgba(255, 170, 0, 0.3);
        }

        /* Filter Controls */
        .filter-btn {
            background: transparent;
            color: #999;
            border: 1px solid var(--ui-border);
            border-radius: 4px;
            padding: 8px 18px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            transition: all 0.3s ease;
        }

        .filter-btn:hover, .filter-btn.active {
            background-color: var(--nissan-red);
            color: #ffffff;
            border-color: var(--nissan-red);
            box-shadow: 0 0 15px var(--neon-glow);
        }

        /* Search Input */
        .search-container {
            position: relative;
        }

        .search-container i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #555;
        }

        .search-input {
            background-color: rgba(255, 255, 255, 0.04);
            border: 1px solid var(--ui-border);
            border-radius: 4px;
            color: #ffffff;
            padding: 10px 15px 10px 42px;
            font-size: 14px;
            transition: all 0.3s ease;
        }

        .search-input:focus {
            background-color: rgba(255, 255, 255, 0.08);
            border-color: var(--nissan-red);
            box-shadow: 0 0 15px var(--neon-glow);
            outline: none;
            color: #ffffff;
        }

        /* Quick View Modal Design styling */
        .modal-gtr .modal-content {
            background-color: var(--dark-gray);
            border: 2px solid var(--nissan-red);
            border-radius: 12px;
            color: #ffffff;
        }

        .modal-gtr .modal-header {
            border-bottom: 1px solid var(--ui-border);
        }

        .modal-gtr .modal-footer {
            border-top: 1px solid var(--ui-border);
        }

        /* Responsive Breakpoint Adaptability */
        @media (max-width: 991.98px) {
            .carousel-caption-custom h1 {
                font-size: 2.8rem;
            }
            .carousel-caption-custom p {
                font-size: 0.9rem;
            }
        }
    </style>
</head>

