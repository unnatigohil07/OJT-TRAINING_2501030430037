<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Tapri Food</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
  
  <script src="https://cdn.tailwindcss.com"></script>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Poppins', sans-serif;
      color: #333;
      background: #fff;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .topbar {
      background: #f5820d;
      color: white;
      text-align: center;
      padding: 8px;
      font-size: 13px;
    }

    /* ---- HERO ---- */
    .hero {
      background: #fff8f0;
      padding: 70px 5%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 40px;
    }

    .hero-text h1 {
      font-size: 42px;
      font-weight: 700;
      line-height: 1.2;
      color: #222;
      margin-bottom: 16px;
    }

    .hero-text h1 span {
      color: #f5820d;
    }

    .hero-text p {
      font-size: 15px;
      color: #666;
      line-height: 1.7;
      max-width: 460px;
      margin-bottom: 28px;
    }

    .hero-buttons {
      display: flex;
      gap: 12px;
    }

    .btn-orange {
      background: #f5820d;
      color: white;
      padding: 12px 24px;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 600;
      border: none;
      cursor: pointer;
    }

    .btn-orange:hover {
      background: #d96e00;
    }

    .btn-white {
      background: white;
      color: #f5820d;
      padding: 12px 24px;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 600;
      border: 2px solid #f5820d;
      cursor: pointer;
    }

    .btn-white:hover {
      background: #fff3e8;
    }

    .hero-image {
      font-size: 130px;
      line-height: 1;
    }

    /* ---- STATS ---- */
    .stats {
      display: flex;
      justify-content: center;
      gap: 60px;
      padding: 40px 5%;
      background: #f5820d;
      color: white;
      text-align: center;
    }

    .stat h2 {
      font-size: 28px;
      font-weight: 700;
    }

    .stat p {
      font-size: 13px;
      opacity: 0.85;
      margin-top: 4px;
    }

    /* ---- SECTION TITLE ---- */
    .section-title {
      text-align: center;
      margin-bottom: 40px;
    }

    .section-title h2 {
      font-size: 28px;
      font-weight: 700;
      color: #222;
    }

    .section-title p {
      font-size: 14px;
      color: #888;
      margin-top: 6px;
    }

    /* ---- CATEGORIES ---- */
    .categories {
      padding: 60px 5%;
      background: #fafafa;
    }

    .cat-grid {
      display: flex;
      gap: 16px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .cat-item {
      background: white;
      border: 2px solid #eee;
      border-radius: 12px;
      padding: 20px 24px;
      text-align: center;
      cursor: pointer;
      width: 130px;
      transition: border-color 0.2s, transform 0.2s;
    }

    .cat-item:hover, .cat-item.active {
      border-color: #f5820d;
      transform: translateY(-3px);
    }

    .cat-item .icon {
      font-size: 32px;
      margin-bottom: 8px;
    }

    .cat-item p {
      font-size: 13px;
      font-weight: 600;
      color: #333;
    }

    /* ---- MENU ---- */
    .menu {
      padding: 60px 5%;
    }

    .menu-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 24px;
      justify-content: center;
    }

    .menu-card {
      background: white;
      border: 1px solid #eee;
      border-radius: 12px;
      width: 260px;
      overflow: hidden;
      transition: box-shadow 0.2s;
    }

    .menu-card:hover {
      box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }

    .menu-card .food-emoji {
      font-size: 70px;
      text-align: center;
      padding: 24px;
      background: #fff8f0;
      display: block;
    }

    .menu-card .card-body {
      padding: 16px;
    }

    .menu-card h3 {
      font-size: 15px;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .menu-card .desc {
      font-size: 12px;
      color: #888;
      line-height: 1.5;
      margin-bottom: 12px;
    }

    .menu-card .card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .menu-card .price {
      font-size: 17px;
      font-weight: 700;
      color: #f5820d;
    }

    .menu-card .add-btn {
      background: #f5820d;
      color: white;
      border: none;
      padding: 7px 14px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }

    .menu-card .add-btn:hover {
      background: #d96e00;
    }

    .menu-card .badge {
      display: inline-block;
      font-size: 11px;
      font-weight: 600;
      padding: 3px 9px;
      border-radius: 20px;
      margin-bottom: 8px;
    }

    .badge-red { background: #ffe0dc; color: #c0392b; }
    .badge-green { background: #d5f5e3; color: #1e8449; }

    /* ---- OFFER ---- */
    .offer {
      background: #1a1a1a;
      color: white;
      padding: 60px 5%;
      text-align: center;
    }

    .offer h2 {
      font-size: 30px;
      font-weight: 700;
      margin-bottom: 10px;
    }

    .offer h2 span {
      color: #f5820d;
    }

    .offer p {
      font-size: 14px;
      color: #aaa;
      margin-bottom: 24px;
    }

    .coupon-box {
      display: inline-flex;
      align-items: center;
      gap: 16px;
      border: 2px dashed #f5820d;
      padding: 14px 28px;
      border-radius: 8px;
      margin-bottom: 24px;
    }

    .coupon-box .code {
      font-size: 22px;
      font-weight: 700;
      color: #f5820d;
      letter-spacing: 2px;
    }

    #copyBtn {
      background: #f5820d;
      color: white;
      border: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
    }

    /* ---- WHY US ---- */
    .why {
      padding: 60px 5%;
      background: #fafafa;
    }

    .why-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
    }

    .why-card {
      background: white;
      border-radius: 12px;
      padding: 28px 24px;
      width: 260px;
      text-align: center;
      border: 1px solid #eee;
    }

    .why-card .icon {
      font-size: 36px;
      margin-bottom: 14px;
    }

    .why-card h3 {
      font-size: 15px;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .why-card p {
      font-size: 13px;
      color: #777;
      line-height: 1.6;
    }

    /* ---- REVIEWS ---- */
    .reviews {
      padding: 60px 5%;
    }

    .review-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      justify-content: center;
    }

    .review-card {
      background: #fff8f0;
      border-radius: 12px;
      padding: 24px;
      width: 280px;
      border-left: 4px solid #f5820d;
    }

    .review-card .stars {
      color: #f5820d;
      font-size: 15px;
      margin-bottom: 10px;
    }

    .review-card p {
      font-size: 13px;
      color: #555;
      line-height: 1.6;
      margin-bottom: 14px;
    }

    .review-card .name {
      font-size: 13px;
      font-weight: 600;
      color: #333;
    }

    .review-card .city {
      font-size: 12px;
      color: #aaa;
    }

    /* ---- CONTACT ---- */
    .contact {
      padding: 60px 5%;
      background: #fafafa;
    }

    .contact-wrap {
      display: flex;
      gap: 50px;
      flex-wrap: wrap;
      justify-content: center;
    }

    .contact-info {
      max-width: 320px;
    }

    .contact-info h2 {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 12px;
    }

    .contact-info p {
      font-size: 14px;
      color: #666;
      line-height: 1.7;
      margin-bottom: 24px;
    }

    .info-item {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 14px;
      font-size: 14px;
      color: #555;
    }

    .info-item span:first-child {
      font-size: 20px;
    }

    .contact-form {
      display: flex;
      flex-direction: column;
      gap: 14px;
      width: 380px;
    }

    .contact-form input,
    .contact-form textarea {
      padding: 12px 14px;
      border: 1.5px solid #ddd;
      border-radius: 8px;
      font-family: 'Poppins', sans-serif;
      font-size: 14px;
      outline: none;
      transition: border-color 0.2s;
    }

    .contact-form input:focus,
    .contact-form textarea:focus {
      border-color: #f5820d;
    }

    .contact-form textarea {
      height: 110px;
      resize: vertical;
    }

    .contact-form button {
      background: #f5820d;
      color: white;
      border: none;
      padding: 13px;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      font-family: 'Poppins', sans-serif;
    }

    .contact-form button:hover {
      background: #d96e00;
    }

    /* ---- FOOTER ---- */
    footer {
      background: #1a1a1a;
      color: #aaa;
      padding: 50px 5% 24px;
    }

    .footer-top {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 32px;
      margin-bottom: 40px;
    }

    .footer-col h4 {
      color: white;
      font-size: 15px;
      margin-bottom: 14px;
    }

    .footer-col p {
      font-size: 13px;
      line-height: 1.7;
      max-width: 240px;
    }

    .footer-col .logo-footer {
      font-size: 20px;
      font-weight: 700;
      color: #f5820d;
      margin-bottom: 10px;
    }

    .footer-col ul {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .footer-col ul a {
      font-size: 13px;
      color: #aaa;
    }

    .footer-col ul a:hover {
      color: #f5820d;
    }

    .footer-bottom {
      border-top: 1px solid #333;
      padding-top: 20px;
      text-align: center;
      font-size: 13px;
    }

    /* ---- RESPONSIVE CSS ---- */
    @media (max-width: 768px) {
      .hero {
        flex-direction: column;
        text-align: center;
        padding: 50px 5%;
      }

      .hero-text h1 { font-size: 30px; }
      .hero-buttons { justify-content: center; }
      .hero-image { font-size: 90px; }

      .stats {
        flex-wrap: wrap;
        gap: 30px;
      }

      .contact-form { width: 100%; }
      .footer-top { flex-direction: column; }
    } /* <-- YEH BRACKET FIX KIYA HAI BHAI */
  </style>
</head>
