<!DOCTYPE html>
<html lang="en">
 
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GT-R Header Component</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Syncopate:wght@400;700&family=Outfit:wght@200;400;600;800&display=swap');

        :root {
            --nissan-red: #E22128;
            --deep-black: #080808;
            --ui-border: rgba(255, 255, 255, 0.1);
        }

        body {
            background-color: var(--deep-black);
            margin: 0;
            font-family: 'Outfit', sans-serif;
        }

        /* HEADER */

        .glass-header {
            background: rgba(8, 8, 8, 0.85);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--ui-border);
            transition: all 0.4s ease;
        }

        .glass-header.scrolled {
            padding: 0.3rem 0;
            background: #000;
            border-bottom: 1px solid var(--nissan-red);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        }

        .nav-link {
            position: relative;
            color: #999;
            transition: color 0.3s ease;
            letter-spacing: 0.25em;
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            text-decoration: none;
        }

        .nav-link:hover {
            color: white;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: 0;
            width: 0;
            height: 2px;
            background-color: var(--nissan-red);
            transition: width 0.3s ease;
        }

        .nav-link:hover::after {
            width: 100%;
        }

        .btn-primary {
            background: var(--nissan-red);
            color: white;
            padding: 12px 32px;
            font-weight: 800;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            font-size: 12px;
            transition: all 0.3s ease;
            border: 1px solid var(--nissan-red);
            cursor: pointer;
        }

        .btn-primary:hover {
            background: transparent;
            color: var(--nissan-red);
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 1.5rem;
        }

        .img-crisp {
            object-fit: contain;
        }

        /* SLIDER */

        .slider {
            position: relative;
            width: 100%;
            height: 100vh;
            overflow: hidden;
        }

        .slide {
            position: absolute;
            width: 100%;
            height: 100%;
            opacity: 0;
            transition: opacity 1s ease-in-out;
        }

        .slide.active {
            opacity: 1;
            z-index: 1;
        }

        .slide img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .overlay {
            position: absolute;
            inset: 0;
            background: rgba(0, 0, 0, 0.45);
        }

        .slide-text {
            position: absolute;
            bottom: 15%;
            left: 8%;
            z-index: 2;
            color: white;
        }

        .slide-text h1 {
            font-size: 80px;
            margin: 0;
            font-weight: 800;
            letter-spacing: 0.1em;
        }

        .slide-text p {
            font-size: 20px;
            letter-spacing: 0.3em;
            color: #ddd;
        }
    </style>
</head>

<body>

    <!-- Utility Bar -->
    <div
        class="bg-black text-[10px] py-2 border-b border-white/10 uppercase tracking-[0.4em] font-bold text-gray-500 relative z-[60]">

        <div class="container mx-auto px-8 flex justify-between items-center">

            <div class="hidden md:block">
                Performance Heritage Division
            </div>

            <div class="flex gap-8">
                <a href="#" class="hover:text-white transition no-underline">Configurator</a>

                <a href="#" class="hover:text-white transition no-underline">Find Dealer</a>
            </div>

        </div>
    </div>

    <!-- Header -->

    <header id="main-header" class="glass-header sticky top-0 z-50 py-5">

        <nav class="container mx-auto px-8 flex items-center justify-between">

            <div class="logo-container">

    <img src="data:image/jpeg;base64," 
         alt="GT-R Logo"
         class="h-12 w-auto rounded-lg shadow-lg">

</div>
            <!-- Menu -->

            <ul class="hidden lg:flex items-center gap-12 list-none m-0 p-0">

                <li><a href="#" class="nav-link">Heritage</a></li>

                <li><a href="#" class="nav-link">R32</a></li>

                <li><a href="#" class="nav-link">R34</a></li>

                <li><a href="#" class="nav-link">R35</a></li>

                <li><a href="#" class="nav-link text-red-600">Nismo</a></li>

            </ul>

            <button class="btn-primary">
                Build Yours
            </button>

        </nav>

    </header>

    <!-- IMAGE SLIDER -->

    <section class="slider">

        <!-- Slide 1 -->
        <div class="slide active">
            <img src="https://s1.cdn.autoevolution.com/images/models/NISSAN_GT-R-2023_main.jpg">
            <div class="overlay"></div>

            <div class="slide-text">
                <h1>GT-R 2023</h1>
                <p>MODERN GODZILLA</p>
            </div>
        </div>

        <!-- Slide 2 -->
        <div class="slide">
            <img src="https://s1.cdn.autoevolution.com/images/models/NISSAN_GT-R-2016_main.jpg">
            <div class="overlay"></div>

            <div class="slide-text">
                <h1>GT-R 2016</h1>
                <p>REFINED POWER</p>
            </div>
        </div>

        <!-- Slide 3 -->
        <div class="slide">
            <img src="https://s1.cdn.autoevolution.com/images/models/NISSAN_GT-R--R35----Facelift-2011_main.jpg">
            <div class="overlay"></div>

            <div class="slide-text">
                <h1>R35 FACELIFT</h1>
                <p>TURBO MONSTER</p>
            </div>
        </div>

        <!-- Slide 4 -->
        <div class="slide">
            <img src="https://s1.cdn.autoevolution.com/images/models/NISSAN_GT-R-2007_main.jpg">
            <div class="overlay"></div>

            <div class="slide-text">
                <h1>GT-R 2007</h1>
                <p>THE LEGEND RETURNS</p>
            </div>
        </div>

        <!-- Slide 5 -->
        <div class="slide">
            <img src="https://s1.cdn.autoevolution.com/images/models/NISSAN_Skyline-GT-R--R34--1999_main.jpg">
            <div class="overlay"></div>

            <div class="slide-text">
                <h1>R34</h1>
                <p>STREET ICON</p>
            </div>
        </div>

        <!-- Slide 6 -->
        <div class="slide">
            <img src="https://s1.cdn.autoevolution.com/images/models/NISSAN_Skyline-GT-R-V-Spec--R34--1999_main.jpg">
            <div class="overlay"></div>

            <div class="slide-text">
                <h1>R34 V-SPEC</h1>
                <p>PURE JAPANESE ENGINEERING</p>
            </div>
        </div>

        <!-- Slide 7 -->
        <div class="slide">
            <img src="https://s1.cdn.autoevolution.com/images/models/NISSAN_Skyline-GT-R--R33--1995_main.jpg">
            <div class="overlay"></div>

            <div class="slide-text">
                <h1>R33</h1>
                <p>90s MONSTER</p>
            </div>
        </div>

    </section>

    <script>

        // HEADER SCROLL EFFECT

        const header = document.getElementById('main-header');

        window.addEventListener('scroll', () => {

            if (window.scrollY > 50) {
                header.classList.add('scrolled');
            }

            else {
                header.classList.remove('scrolled');
            }

        });

        // IMAGE SLIDER

        const slides = document.querySelectorAll('.slide');

        let currentSlide = 0;

        function showSlide(index) {

            slides.forEach(slide => {
                slide.classList.remove('active');
            });

            slides[index].classList.add('active');
        }

        setInterval(() => {

            currentSlide++;

            if (currentSlide >= slides.length) {
                currentSlide = 0;
            }

            showSlide(currentSlide);

        }, 4000);

    </script>

</body>

</html>
