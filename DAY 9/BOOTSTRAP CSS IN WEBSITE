    <style>
        @import url('https://fonts.googleapis.com/css2?family=Syncopate:wght@700&family=Outfit:wght@200;400;600;800&display=swap');

        :root {
            --nissan-red: #E22128;
            --ui-border: rgba(255, 255, 255, 0.1);
            --neon-glow: rgba(226, 33, 40, 0.3);
        }

        body {
            background-color: #080808;
            font-family: 'Outfit', sans-serif;
        }

        .font-sync {
            font-family: 'Syncopate', sans-serif;
        }
        .glass-header {
            background: rgba(8, 8, 8, 0.85);
            backdrop-filter: blur(15px);
            border-bottom: 1px solid var(--ui-border);
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .glass-header.scrolled {
            padding: 0.4rem 0 !important;
            background: rgba(0, 0, 0, 0.95);
            border-bottom: 2px solid var(--nissan-red);
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8);
        }

        .nav-link-gtr {
            position: relative;
            letter-spacing: 0.25em;
        }

        .nav-link-gtr::after {
            content: '';
            position: absolute;
            bottom: -2px;
            left: 10%;
            width: 0;
            height: 2px;
            background-color: var(--nissan-red);
            transition: width 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .nav-link-gtr:hover::after, .nav-link-gtr.active::after {
            width: 80%;
        }

        .btn-gtr-primary {
            background: var(--nissan-red);
            border: 1px solid var(--nissan-red);
            letter-spacing: 0.2em;
            transition: all 0.3s ease;
        }

        .btn-gtr-primary:hover {
            background: transparent;
            color: var(--nissan-red) !important;
            box-shadow: 0 0 15px var(--neon-glow);
        }

        .btn-gtr-outline {
            border: 1px solid var(--ui-border);
            letter-spacing: 0.2em;
            transition: all 0.3s ease;
        }

        .btn-gtr-outline:hover {
            background: rgba(255, 255, 255, 0.1);
            border-color: #ffffff;
        }

        .carousel-item {
            height: 85vh;
            min-height: 500px;
        }

        .carousel-item img {
            object-fit: cover;
            transition: transform 6s ease;
        }

        .carousel-item.active img {
            transform: scale(1.05);
        }

        .carousel-overlay {
            background: linear-gradient(to top, rgba(8, 8, 8, 1) 5%, rgba(8, 8, 8, 0.3) 50%, rgba(8, 8, 8, 0.7) 100%);
        }

        .carousel-caption-custom p {
            letter-spacing: 0.3em;
            border-left: 3px solid var(--nissan-red);
        }

        .carousel-indicators .active {
            background-color: var(--nissan-red) !important;
            box-shadow: 0 0 10px var(--nissan-red);
        }

        .spec-table-container {
            border: 1px solid var(--ui-border);
            transition: all 0.3s ease;
        }

        .spec-table-container:hover {
            border-color: rgba(226, 33, 40, 0.35);
            box-shadow: 0 25px 60px rgba(226, 33, 40, 0.1);
        }

        .table-gtr th {
            letter-spacing: 0.15em;
        }

        .table-gtr tbody tr:hover td {
            background-color: rgba(255, 255, 255, 0.03) !important;
            color: #ffffff !important;
        }

        .filter-btn {
            border: 1px solid var(--ui-border);
            letter-spacing: 0.15em;
            transition: all 0.3s ease;
        }

        .filter-btn:hover, .filter-btn.active {
            background-color: var(--nissan-red);
            border-color: var(--nissan-red);
            box-shadow: 0 0 15px var(--neon-glow);
        }

        .search-input:focus {
            border-color: var(--nissan-red);
            box-shadow: 0 0 15px var(--neon-glow);
        }
    </style>
</head>

