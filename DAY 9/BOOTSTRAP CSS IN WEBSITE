    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        window.addEventListener('scroll', function() {
            const header = document.getElementById('main-header');
            if (window.scrollY > 50) {
                header.classList.add('scrolled');
            } else {
                header.classList.remove('scrolled');
            }
        });

        let currentGenerationFilter = 'all';

        function processTableFilters() {
            const searchQuery = document.getElementById('gtrSearch').value.toLowerCase();
            const rows = document.querySelectorAll('#gtrSpecTable tbody tr');

            rows.forEach(row => {
                const generationMatch = (currentGenerationFilter === 'all' || row.getAttribute('data-gen') === currentGenerationFilter);
                const textContent = row.textContent.toLowerCase();
                const searchMatch = textContent.includes(searchQuery);

                if (generationMatch && searchMatch) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function filterGeneration(event, gen) {
            currentGenerationFilter = gen;
            
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            event.currentTarget.classList.add('active');
            
            processTableFilters();
        }

        document.getElementById('gtrSearch').addEventListener('input', processTableFilters);

        let specModalElement;
        document.addEventListener("DOMContentLoaded", function() {
            specModalElement = new bootstrap.Modal(document.getElementById('specDetailModal'));
        });

        function showSpecDetails(title, engine, power, accel, speed, transmission, weight, drivetrain) {
            document.getElementById('modalTitle').textContent = title + " Profile Specifications";
            document.getElementById('modalEngine').textContent = engine;
            document.getElementById('modalPower').textContent = power;
            document.getElementById('modalAccel').textContent = accel;
            document.getElementById('modalTopSpeed').textContent = speed;
            document.getElementById('modalTransmission').textContent = transmission;
            document.getElementById('modalWeight').textContent = weight;
            document.getElementById('modalDrivetrain').textContent = drivetrain;
            
            if(specModalElement) {
                specModalElement.show();
            }
        }
    </script>
